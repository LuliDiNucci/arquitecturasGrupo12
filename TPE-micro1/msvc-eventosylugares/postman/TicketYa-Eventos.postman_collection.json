    "name": "TicketYa - msvc-eventos Entrega 1",
    "description": "Coleccion para verificar eventos y lugares. Ejecutar carpetas en orden, preferiblemente sobre una base vacia. Solo verifica el microservicio Eventos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generamos una fecha futura al ejecutar la coleccion.",
          "if (!pm.collectionVariables.get(\"fechaEvento\")) {",
          "  let fecha = new Date();",
          "  fecha.setDate(fecha.getDate() + 60);",
          "  pm.collectionVariables.set(\"fechaEvento\", fecha.toISOString().slice(0, 19));",
          "}"
        ]
      }
    }
  ],
