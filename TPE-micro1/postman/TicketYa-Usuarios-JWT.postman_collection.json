              "body": "{\n  \"accessToken\": \"<JWT_RS256>\",\n  \"tokenType\": \"Bearer\",\n  \"expiresIn\": 3600,\n  \"expiresAt\": \"2026-11-16T21:00:00Z\",\n  \"usuario\": {\n    \"id\": 12,\n    \"nombre\": \"Ana\",\n    \"apellido\": \"Pérez\",\n    \"email\": \"ana@example.com\",\n    \"roles\": [\n      \"CLIENTE\"\n    ],\n    \"activo\": true,\n    \"fechaCreacion\": \"2026-11-16T20:00:00Z\"\n  }\n}"
            }
