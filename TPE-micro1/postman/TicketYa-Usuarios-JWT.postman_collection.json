              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const r = pm.response.json(); pm.collectionVariables.set(\"token\", r.accessToken);",
                  "pm.test(\"Bearer temporal\", () => { pm.expect(r.tokenType).to.eql(\"Bearer\"); pm.expect(r.expiresIn).to.be.above(0); pm.expect(r.usuario).not.to.have.property(\"passwordHash\"); });"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Ejemplo 200",
              "originalRequest": {
                "method": "POST",
                "header": [
