    {
      "name": "Integración — usar baseUrl http://localhost:8084",
      "item": [
        {
          "name": "Eventos públicos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/eventos/publicados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "eventos",
