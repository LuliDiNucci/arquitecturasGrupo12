  "item": [
    {
      "name": "Cliente — registro, login y rechazos",
      "item": [
        {
          "name": "1. Registro ignora intento de ADMINISTRADOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"roles\": [\n    \"ADMINISTRADOR\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", \"cliente-\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const u = pm.response.json(); pm.collectionVariables.set(\"clientId\", u.id);",
                  "pm.test(\"Sólo CLIENTE, sin hash\", () => { pm.expect(u.roles).to.eql([\"CLIENTE\"]); pm.expect(u).not.to.have.property(\"passwordHash\"); });"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Ejemplo 201",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/auth/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "auth",
                    "register"
                  ]
                },
                "auth": {
                  "type": "noauth"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"roles\": [\n    \"ADMINISTRADOR\"\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": 12,\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"ana@example.com\",\n  \"roles\": [\n    \"CLIENTE\"\n  ],\n  \"activo\": true,\n  \"fechaCreacion\": \"2026-11-16T20:00:00Z\"\n}"
            }
          ]
        },
