","example":21},"fechaCompra":{"type":"string","format":"date","description":"Fecha en que se inició la compra","example":"2026-11-05"},"total":{"type":"number","description":"Importe total de la compra","example":30000.0},"estado":{"type":"string","description":"Estado de la compra","example":"PENDIENTE"},"detalles":{"type":"array","description":"Detalle de sectores y entradas adquiridas","items":{"$ref":"#/components/schemas/DetalleCompraRespuestaDTO"}}}},"DetalleCompraRespuestaDTO":{"type":"object","description":"Detalle de un sector incluido en una compra","properties":{"id":{"type":"integer","format":"int64","description":"ID del detalle","example":1},"eventoId":{"type":"integer","format":"int64","description":"ID del evento","example":21},"sectorId":{"type":"integer","format":"int64","description":"ID del sector","example":5},"cantidad":{"type":"integer","format":"int32","description":"Cantidad de entradas","example":2},"precioUnitario":{"type":"number","description":"Precio unitario al iniciar la compra","example":15000.0},"subtotal":{"type":"number","description":"Subtotal del sector","example":30000.0},"items":{"type":"array","description":"Entradas individuales de este detalle","items":{"$ref":"#/components/schemas/ItemCompraDTO"}}}},"ItemCompraDTO":{"type":"object","description":"Entrada individual incluida en una compra","properties":{"id":{"type":"integer","format":"int64","description":"ID del item de compra","example":1},"asientoId":{"type":["integer","null"],"format":"int64","description":"ID del asiento, si el sector es numerado","example":25},"entradaId":{"type":["integer","null"],"format":"int64","description":"ID de la entrada emitida después del pago"}}},"ProcesarPagoDTO":{"type":"object","description":"Solicitud para procesar el pago de una compra","properties":{"medioPago":{"type":"string","description":"Medio de pago seleccionado","example":"TARJETA"},"claveIdempotencia":{"type":"string","description":"Clave única para evitar cobros duplicado