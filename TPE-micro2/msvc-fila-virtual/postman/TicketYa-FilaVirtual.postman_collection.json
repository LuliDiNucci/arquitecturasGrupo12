{
    "info": {
        "name": "TicketYa - Fila Virtual",
        "description": "Pruebas funcionales de Fila Virtual para eventos de alta demanda. Ejecutar las solicitudes en el orden indicado. Requiere msvc-fila-virtual y msvc-eventosylugares funcionando.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "01 - Ingresar primer cliente",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "exec": [
                            "const base = Date.now();",
                            "pm.collectionVariables.set('clienteId', String(base));",
                            "pm.collectionVariables.set('segundoClienteId', String(base + 1));"
                        ],
                        "type": "text/javascript"
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('Cliente en espera', () => pm.expect(data.estado).to.eql('EN_ESPERA'));",
                            "pm.test('Tiene ID', () => pm.expect(data.id).to.exist);",
                            "pm.test('Tiene posición', () => pm.expect(data.posicion).to.be.a('number'));",
                            "pm.collectionVariables.set('registroId', String(data.id));",
                            "pm.collectionVariables.set('posicionOriginal', String(data.posicion));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"clienteId\": {{clienteId}}\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/filas/{{eventoId}}/ingresar",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "filas",
                        "{{eventoId}}",
                        "ingresar"
                    ]
                }
            }
        },
        {
            "name": "02 - Repetir ingreso del primer cliente",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('Mismo registro', () => pm.expect(String(data.id)).to.eql(pm.collectionVariables.get('registroId')));",
                            "pm.test('Conserva posición', () => pm.expect(String(data.posicion)).to.eql(pm.collectionVariables.get('posicionOriginal')));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"clienteId\": {{clienteId}}\n}"
                },
                "url": "{{baseUrl}}/filas/{{eventoId}}/ingresar"
            }
        },
        {
            "name": "03 - Ingresar segundo cliente",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('Segundo cliente en espera', () => pm.expect(data.estado).to.eql('EN_ESPERA'));",
                            "pm.test('Registro diferente', () => pm.expect(String(data.id)).to.not.eql(pm.collectionVariables.get('registroId')));",
                            "pm.collectionVariables.set('segundoRegistroId', String(data.id));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"clienteId\": {{segundoClienteId}}\n}"
                },
                "url": "{{baseUrl}}/filas/{{eventoId}}/ingresar"
            }
        },
        {
            "name": "04 - Consultar posición del primer cliente",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('Estado EN_ESPERA', () => pm.expect(data.estado).to.eql('EN_ESPERA'));",
                            "pm.test('Posición original', () => pm.expect(String(data.posicion)).to.eql(pm.collectionVariables.get('posicionOriginal')));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/filas/{{eventoId}}/clientes/{{clienteId}}"
            }
        },
        {
            "name": "05 - Validar cliente en espera",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('No autorizado', () => pm.expect(data.autorizado).to.eql(false));",
                            "pm.test('Estado EN_ESPERA', () => pm.expect(data.estado).to.eql('EN_ESPERA'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/filas/{{eventoId}}/clientes/{{clienteId}}/validar"
            }
        },
        {
            "name": "06 - Habilitar primer cliente",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('Un cliente habilitado', () => pm.expect(data).to.have.lengthOf(1));",
                            "pm.test('Estado HABILITADO', () => pm.expect(data[0].estado).to.eql('HABILITADO'));",
                            "pm.test('Turno con vencimiento', () => pm.expect(data[0].fechaVencimiento).to.exist);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"cantidad\": 1\n}"
                },
                "url": "{{baseUrl}}/filas/{{eventoId}}/habilitar"
            }
        },
        {
            "name": "07 - Validar turno habilitado",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('Cliente autorizado', () => pm.expect(data.autorizado).to.eql(true));",
                            "pm.test('Estado HABILITADO', () => pm.expect(data.estado).to.eql('HABILITADO'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/filas/{{eventoId}}/clientes/{{clienteId}}/validar"
            }
        },
        {
            "name": "08 - Rechazar segunda tanda activa",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"cantidad\": 1\n}"
                },
                "url": "{{baseUrl}}/filas/{{eventoId}}/habilitar"
            }
        },
        {
            "name": "09 - Finalizar turno",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('Estado FINALIZADO', () => pm.expect(data.estado).to.eql('FINALIZADO'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "url": "{{baseUrl}}/filas/{{eventoId}}/clientes/{{clienteId}}/finalizar"
            }
        },
        {
            "name": "10 - Repetir finalización",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('Permanece FINALIZADO', () => pm.expect(data.estado).to.eql('FINALIZADO'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "url": "{{baseUrl}}/filas/{{eventoId}}/clientes/{{clienteId}}/finalizar"
            }
        },
        {
            "name": "11 - Validar turno finalizado",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                            "const data = pm.response.json();",
                            "pm.test('No autorizado', () => pm.expect(data.autorizado).to.eql(false));",
                            "pm.test('Estado FINALIZADO', () => pm.expect(data.estado).to.eql('FINALIZADO'));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/filas/{{eventoId}}/clientes/{{clienteId}}/validar"
            }
        },
        {
            "name": "12 - Consultar cliente inexistente",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/filas/{{eventoId}}/clientes/999999999999/validar"
            }
        },
        {
            "name": "13 - Rechazar ingreso inválido",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"clienteId\": -1\n}"
                },
                "url": "{{baseUrl}}/filas/{{eventoId}}/ingresar"
            }
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8088"
        },
        {
            "key": "eventoId",
            "value": "1"
        },
        {
            "key": "clienteId",
            "value": ""
        },
        {
            "key": "segundoClienteId",
            "value": ""
        },
        {
            "key": "registroId",
            "value": ""
        },
        {
            "key": "segundoRegistroId",
            "value": ""
        },
        {
            "key": "posicionOriginal",
            "value": ""
        }
    ]
}