// Mismo proyecto Compose: volumen de contenedores y carpeta de ejecución local.
// No se monta docker.sock ni se eleva correlationId a una etiqueta de Loki.
local.file_match "ticketya" {
  path_targets = [
    { __path__ = "/var/log/ticketya/*.log", job = "ticketya", runtime = "docker" },
    { __path__ = "/var/log/ticketya-local/*.log", job = "ticketya", runtime = "local" },
  ]
  sync_period = "5s"
}

loki.source.file "ticketya" {
  targets    = local.file_match.ticketya.targets
  forward_to = [loki.process.ticketya.receiver]
}

loki.process "ticketya" {
  stage.json {
    expressions = { servicio = "servicio", level = "level", timestamp = "\"@timestamp\"" }
  }
  stage.labels {
    values = { servicio = "", level = "" }
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  forward_to = [loki.write.ticketya.receiver]
}

loki.write "ticketya" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
